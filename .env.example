# UPI Guard Environment
# Copy this file to .env and fill values

# Flask
SECRET_KEY=replace_with_random_secret
JWT_SECRET=replace_with_random_jwt_secret

# Default terminal mode: demo | mock | live | razorpay_test
PAYMENT_MODE_DEFAULT=razorpay_test

# Razorpay Test Mode (fill these)
RAZORPAY_KEY_ID=rzp_test_SqKyxdSEvSMYmY
RAZORPAY_KEY_SECRET=CqJIrm9Xb2Q5Oa97oEJ6A6Qr
WEBHOOK_SECRET=replace_with_same_secret_used_in_razorpay_webhook

# Optional fallback for direct UPI QR mode
MERCHANT_UPI_VPA=your_upi_id@bank

# Optional PhonePe live config (keep blank if not using PhonePe)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENVIRONMENT=sandbox

# PostgreSQL (Docker: postgresql://upiguard:upiguard@db:5432/upiguard)
DATABASE_URL=postgresql://upiguard:upiguard@localhost:5432/upiguard

# Redis (Docker: redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0
