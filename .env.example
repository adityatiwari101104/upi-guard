# ─────────────────────────────────────────────
# UPI Guard — Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# Flask
SECRET_KEY=change-this-to-a-random-string

# Cashfree — get these from https://merchant.cashfree.com
CASHFREE_CLIENT_ID=your_client_id
CASHFREE_CLIENT_SECRET=your_client_secret

# Cashfree Webhook Secret — set when creating webhook in dashboard
CASHFREE_WEBHOOK_SECRET=your_webhook_secret

# Environment: sandbox or production
CASHFREE_ENVIRONMENT=sandbox

# Optional: default checkout mode (live or demo)
PAYMENT_MODE_DEFAULT=live
