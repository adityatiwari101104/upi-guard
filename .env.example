# UPI Guard - Environment Variables
# Copy this to .env and fill in your values

# Flask
SECRET_KEY=change-this-to-a-random-string

# PhonePe Standard Checkout credentials
PHONEPE_CLIENT_ID=your_client_id
PHONEPE_CLIENT_SECRET=your_client_secret
PHONEPE_CLIENT_VERSION=1

# Environment: sandbox or production
PHONEPE_ENVIRONMENT=sandbox

# Mock gateway + UPI deep-link mode
MERCHANT_UPI_VPA=yourshop@okaxis
MOCK_WEBHOOK_SECRET=change-this-mock-webhook-secret

# Optional: default checkout mode (live or demo or mock)
PAYMENT_MODE_DEFAULT=mock
